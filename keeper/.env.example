# Batpilot keeper env — copy to .env (gitignored). One keeper watches ALL chains.
# WATCH="label:chainId:vault:rpcUrl,label:chainId:vault:rpcUrl,..."
PRIVATE_KEY=0xYOUR_KEEPER_KEY
WATCH=testnet:46630:0x05295a3c41Ac537a5C1a5E9203eD7f98Be86A8bb:https://rpc.testnet.chain.robinhood.com,mainnet:4663:0xbA2fDa0a4411d8C2548d7dA5A4B32EEc8cD66483:https://rpc.mainnet.chain.robinhood.com
INTERVAL_MS=30000
