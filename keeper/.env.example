# Batpilot keeper env — copy to .env (gitignored). One keeper watches ALL chains.
# WATCH="label:chainId:vault:rpcUrl,label:chainId:vault:rpcUrl,..."
PRIVATE_KEY=0xYOUR_KEEPER_KEY
WATCH=testnet:46630:0x9e75555936a2097Ce281De7EFb5CdCC281277BF5:https://rpc.testnet.chain.robinhood.com,mainnet:4663:0xde7b9F01C566A4f8AdcF57CbFC738E5EA2b7Fa0a:https://rpc.mainnet.chain.robinhood.com
INTERVAL_MS=30000
