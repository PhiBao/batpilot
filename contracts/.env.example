# Batpilot deploy env — NEVER commit this file (gitignored).
# Usage: set -a; source .env; set +a
# Then: forge script script/Deploy.s.sol --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast

# Deployer key (0x-prefixed). Use a dedicated testnet key; mainnet key only for mainnet runs.
PRIVATE_KEY=0xYOUR_KEY_HERE

# Target chain RPC
# Local:      http://127.0.0.1:8545
# RHC testnet: https://rpc.testnet.chain.robinhood.com  (chain id 46630)
# RHC mainnet: https://rpc.mainnet.chain.robinhood.com  (chain id 4663)
# Arb Sepolia: https://sepolia-rollup.arbitrum.io/rpc   (chain id 421614)
RPC_URL=http://127.0.0.1:8545

# true = deploy demo mocks (local / testnet / Sepolia). false = wire real venues below.
DEPLOY_MOCKS=true

# Live venue addresses (only used when DEPLOY_MOCKS=false)
# RHC mainnet defaults:
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SWAP_ROUTER02=0xCaf681a66D020601342297493863E78C959E5cb2
EARN_VAULT=0xBeEff033F34C046626B8D0A041844C5d1A5409dd
